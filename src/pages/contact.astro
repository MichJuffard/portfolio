---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact"
  description="Contacter Michel Juffard pour une alternance en systèmes, réseaux ou cybersécurité, ou échanger autour de ses projets techniques."
>
  <section class="page-intro contact-intro">
    <p class="eyebrow">~/contact</p>
    <h1>Échangeons.</h1>
    <p>Je suis disponible pour parler d’opportunités d’alternance en systèmes, réseaux ou cybersécurité, ainsi que de mes projets techniques.</p>
    <p>Vous pouvez aussi me contacter pour échanger autour de Linux, des réseaux et de l’infrastructure.</p>
  </section>
  <section class="contact-methods" aria-label="Moyens de contact">
    <article class="contact-card">
      <p class="eyebrow">01 / CODE</p>
      <h2>GitHub</h2>
      <a href="https://github.com/MichJuffard" target="_blank" rel="noopener noreferrer">MichJuffard <span aria-hidden="true">↗</span></a>
    </article>
    <article class="contact-card">
      <p class="eyebrow">02 / E-MAIL</p>
      <h2>E-mail</h2>
      <a href="mailto:juffard.michel@gmail.com">juffard.michel@gmail.com</a>
    </article>
    <article class="contact-card">
      <p class="eyebrow">03 / PARCOURS</p>
      <h2>LinkedIn</h2>
      <a href="https://www.linkedin.com/in/michel-juffard/" target="_blank" rel="noopener noreferrer">Michel Juffard <span aria-hidden="true">↗</span></a>
    </article>
  </section>
</BaseLayout>

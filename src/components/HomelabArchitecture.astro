<figure class="homelab-architecture" data-homelab-architecture aria-labelledby="homelab-architecture-title">
  <figcaption id="homelab-architecture-title">Infrastructure et état des services</figcaption>
  <p class="topology-intro">Les VM et LXC autorisés sont chargés depuis l’inventaire public périodique. Ouvrez un environnement pour lire son rôle ; son état décrit celui rapporté par Proxmox, pas la disponibilité de son service. Le schéma des flux reste consultable sans JavaScript.</p>

  <div class="topology-map" aria-label="Schéma interactif de l’infrastructure">
    <details class="topology-node topology-server" open>
      <summary><span class="topology-kind">Serveur physique · 8 Go RAM</span><strong>Proxmox VE</strong></summary>
      <p>Hyperviseur qui héberge des VM et des LXC. La capacité limitée impose de surveiller l’usage mémoire et de dimensionner les services avec soin.</p>
    </details>
    <p class="topology-connector topology-virtualization"><span aria-hidden="true">↓</span> virtualisation · VM et LXC</p>

    <section class="topology-guests" aria-labelledby="topology-guests-title">
      <header class="topology-inventory-header">
        <h2 id="topology-guests-title">VM et LXC autorisés à la publication</h2>
        <p class="architecture-state" data-inventory-state role="status" aria-live="polite">Inventaire public non chargé</p>
      </header>
      <noscript><p class="architecture-note">JavaScript doit être activé pour afficher les environnements et leurs états. Les flux d’architecture ci-dessous restent consultables.</p></noscript>
      <ul class="architecture-services" data-inventory-services aria-label="Environnements publics sélectionnés par le collecteur"></ul>
      <dl class="architecture-meta">
        <div>
          <dt>Dernière collecte</dt>
          <dd><time data-inventory-time>Aucune collecte reçue</time></dd>
        </div>
      </dl>
      <p class="architecture-note" data-inventory-note>
        Seuls les environnements explicitement autorisés par le collecteur figurent dans le JSON public ; aucun autre état n’est déduit du schéma.
      </p>
    </section>

    <section class="topology-flows-panel" aria-labelledby="topology-flows-title">
      <h2 id="topology-flows-title">Flux d’architecture</h2>
      <ul class="topology-flows">
        <li><span class="topology-badge topology-admin">Administration distante</span><span>WireGuard fournit l’accès privé au homelab ; l’administration de Grafana passe par un tunnel SSH.</span></li>
        <li><span class="topology-badge topology-metrics">Supervision privée</span><span>L’API Proxmox alimente PVE Exporter, Prometheus puis Grafana. L’exporter et Prometheus écoutent localement ; Grafana n’est pas exposé sur Internet.</span></li>
        <li><span class="topology-badge topology-public">Publication contrôlée</span><span>Le collecteur filtre les environnements autorisés et publie les seuls champs prévus dans des fichiers JSON statiques vers OVHcloud.</span></li>
      </ul>
    </section>

    <p class="topology-connector topology-publication"><span aria-hidden="true">↓</span> fichiers JSON publics · HTTPS</p>
    <details class="topology-node topology-portfolio">
      <summary><span class="topology-kind">Site public · OVHcloud</span><strong>Portfolio mjuffard.fr</strong></summary>
      <p>Le site statique lit les fichiers JSON périodiques pour afficher l’inventaire choisi et un jeu limité de métriques. Le navigateur ne contacte ni Proxmox ni les LXC ; les métriques détaillées et Grafana restent privés.</p>
      <span class="topology-badge topology-public">Seules les données prévues sont publiques</span>
    </details>
  </div>
</figure>

<script>
  import { getHomelabServiceViews } from '../data/homelab-service-view';
  import {
    getHomelabInventoryFreshness,
    HOMELAB_INVENTORY_MAX_AGE_MS,
    HOMELAB_INVENTORY_REFRESH_MS,
    loadHomelabInventory,
  } from '../lib/homelab-inventory';
  import type { HomelabInventory, HomelabInventoryFreshness } from '../types/homelab-inventory';

  type DisplayMode = 'normal' | 'unavailable' | 'invalid' | 'inconsistent' | 'error';

  function formatCollectionTime(value: string): string {
    const formatted = new Intl.DateTimeFormat('fr-FR', {
      dateStyle: 'medium',
      timeStyle: 'short',
      timeZone: 'UTC',
    }).format(new Date(value));
    return `${formatted} UTC`;
  }

  function initializeArchitecture(): void {
    const root = document.querySelector<HTMLElement>('[data-homelab-architecture]');
    if (!root || root.dataset.inventoryInitialized === 'true') return;

    const stateElement = root.querySelector<HTMLElement>('[data-inventory-state]');
    const noteElement = root.querySelector<HTMLElement>('[data-inventory-note]');
    const timeElement = root.querySelector<HTMLTimeElement>('[data-inventory-time]');
    const servicesElement = root.querySelector<HTMLUListElement>('[data-inventory-services]');
    if (!stateElement || !servicesElement || !timeElement) return;

    root.dataset.inventoryInitialized = 'true';
    let lastSnapshot: HomelabInventory | null = null;
    let refreshTimer: number | undefined;
    let freshnessTimer: number | undefined;
    let requestTimer: number | undefined;
    let activeRequest: AbortController | null = null;
    let isRefreshing = false;
    let disposed = false;
    let displayMode: DisplayMode = 'normal';

    const renderCollectionTime = (snapshot: HomelabInventory | null) => {
      if (snapshot) {
        timeElement.dateTime = snapshot.collected_at;
        timeElement.textContent = formatCollectionTime(snapshot.collected_at);
      } else {
        timeElement.removeAttribute('datetime');
        timeElement.textContent = 'Aucune collecte reçue';
      }
    };

    const renderServices = (snapshot: HomelabInventory | null, unverified = false) => {
      servicesElement.replaceChildren();
      if (!snapshot) return;

      for (const service of getHomelabServiceViews(snapshot.services)) {
        const item = document.createElement('li');
        item.className = 'architecture-service';
        const card = document.createElement('details');
        card.className = 'architecture-service-card';
        const summary = document.createElement('summary');

        const type = document.createElement('span');
        type.className = 'architecture-service-type';
        type.textContent = service.typeLabel;

        const name = document.createElement('strong');
        name.className = 'architecture-service-name';
        name.textContent = service.name;

        const description = document.createElement('p');
        description.className = 'architecture-service-description';
        description.textContent = service.description;

        const status = document.createElement('span');
        status.className = 'architecture-service-status';
        status.dataset.serviceStatus = unverified ? 'unverified' : service.status;
        status.textContent = unverified
          ? `État non vérifié · dernière valeur : ${service.statusLabel}`
          : service.statusLabel;

        summary.append(type, name, status);
        card.append(summary, description);
        item.append(card);
        servicesElement.append(item);
      }
    };

    const renderSnapshot = (snapshot: HomelabInventory, freshness: HomelabInventoryFreshness) => {
      displayMode = 'normal';
      root.dataset.inventoryState = freshness;
      renderCollectionTime(snapshot);
      renderServices(snapshot, freshness === 'stale');

      if (freshness === 'stale') {
        stateElement.textContent = 'Dernières données anciennes';
        if (noteElement) {
          noteElement.textContent = 'Cette collecte date de 15 minutes ou plus. La liste et ses états ne confirment ni les autorisations ni la situation actuelles.';
        }
      } else if (snapshot.services.length === 0) {
        stateElement.textContent = 'Aucun environnement public dans l’inventaire';
        if (noteElement) noteElement.textContent = 'La dernière collecte valide ne contient aucun environnement autorisé à être présenté.';
      } else {
        stateElement.textContent = 'Collecte dans le délai de fraîcheur';
        if (noteElement) {
          noteElement.textContent = 'Les noms, descriptions et états proviennent du JSON public validé. Les champs textuels absents reçoivent un libellé neutre.';
        }
      }
    };

    const renderFailure = (reason: 'unavailable' | 'invalid' | 'future-timestamp') => {
      displayMode = reason === 'future-timestamp'
        ? 'inconsistent'
        : reason === 'invalid'
          ? 'invalid'
          : 'unavailable';
      root.dataset.inventoryState = displayMode;
      renderCollectionTime(lastSnapshot);
      renderServices(lastSnapshot, true);

      if (reason === 'future-timestamp') {
        stateElement.textContent = 'Horodatage incohérent';
        if (noteElement) {
          noteElement.textContent = lastSnapshot
            ? 'La source annonce une collecte située dans le futur. Les cartes éventuelles reprennent la dernière collecte vérifiée et ne sont pas présentées comme actuelles.'
            : 'La date de collecte annoncée est située dans le futur ; l’inventaire ne peut pas être considéré comme actuel.';
        }
      } else if (reason === 'invalid') {
        stateElement.textContent = 'Inventaire reçu mais invalide';
        if (noteElement) {
          noteElement.textContent = 'Le serveur a répondu, mais le JSON ne respecte pas le contrat public attendu. Vérifiez collected_at, services et les champs autorisés.';
        }
      } else {
        stateElement.textContent = 'Inventaire temporairement indisponible';
        if (noteElement) {
          noteElement.textContent = lastSnapshot
            ? 'La dernière lecture a échoué. Les cartes éventuelles reprennent la collecte précédente ; leur état et leur autorisation actuelle ne sont pas vérifiés.'
            : 'Le fichier public de l’inventaire n’a pas pu être récupéré.';
        }
      }
    };

    const renderUnexpectedError = (error: unknown) => {
      console.error('Erreur inattendue pendant le traitement de l’inventaire du homelab.', error);
      displayMode = 'error';
      root.dataset.inventoryState = displayMode;
      stateElement.textContent = 'Erreur de traitement de l’inventaire';
      if (noteElement) {
        noteElement.textContent = 'La requête a abouti, mais le navigateur n’a pas pu traiter ou afficher les données reçues. Le détail technique est disponible dans la console.';
      }
    };

    const clearFreshnessTimer = () => {
      if (freshnessTimer !== undefined) window.clearTimeout(freshnessTimer);
      freshnessTimer = undefined;
    };

    const scheduleFreshnessUpdate = (snapshot: HomelabInventory) => {
      clearFreshnessTimer();
      if (getHomelabInventoryFreshness(snapshot) !== 'current') return;

      const becomesStaleAt = Date.parse(snapshot.collected_at) + HOMELAB_INVENTORY_MAX_AGE_MS;
      freshnessTimer = window.setTimeout(() => {
        if (disposed || lastSnapshot !== snapshot || displayMode !== 'normal') return;
        const freshness = getHomelabInventoryFreshness(snapshot);
        if (freshness === 'stale') renderSnapshot(snapshot, freshness);
        else if (freshness === 'current') scheduleFreshnessUpdate(snapshot);
      }, Math.max(1, becomesStaleAt - Date.now()));
    };

    const refresh = async () => {
      if (disposed || isRefreshing) return;
      isRefreshing = true;
      const controller = new AbortController();
      activeRequest = controller;
      requestTimer = window.setTimeout(() => controller.abort(), 10_000);

      try {
        const result = await loadHomelabInventory(fetch, Date.now(), controller.signal);
        if (disposed) return;
        if (!result.ok) {
          renderFailure(result.reason);
          return;
        }

        lastSnapshot = result.snapshot;
        try {
          renderSnapshot(result.snapshot, result.freshness);
          scheduleFreshnessUpdate(result.snapshot);
        } catch (error) {
          renderUnexpectedError(error);
        }
      } catch (error) {
        if (!disposed) renderUnexpectedError(error);
      } finally {
        if (requestTimer !== undefined) window.clearTimeout(requestTimer);
        requestTimer = undefined;
        if (activeRequest === controller) activeRequest = null;
        isRefreshing = false;
      }
    };

    const dispose = () => {
      if (disposed) return;
      disposed = true;
      if (refreshTimer !== undefined) window.clearInterval(refreshTimer);
      clearFreshnessTimer();
      if (requestTimer !== undefined) window.clearTimeout(requestTimer);
      activeRequest?.abort();
      delete root.dataset.inventoryInitialized;
      window.removeEventListener('pagehide', dispose);
      document.removeEventListener('astro:before-swap', dispose);
    };

    window.addEventListener('pagehide', dispose, { once: true });
    document.addEventListener('astro:before-swap', dispose, { once: true });
    void refresh();
    refreshTimer = window.setInterval(() => void refresh(), HOMELAB_INVENTORY_REFRESH_MS);
  }

  initializeArchitecture();
  document.addEventListener('astro:page-load', initializeArchitecture);
  window.addEventListener('pageshow', initializeArchitecture);
</script>

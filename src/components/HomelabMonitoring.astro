---
import {
  getMonitoringMetricLabel,
  getMonitoringStateLabel,
  monitoringMetricNames,
} from '../lib/homelab-monitoring';

const initialState = 'unavailable' as const;
---

<section class="monitor-panel" data-monitor-panel data-state={initialState} aria-labelledby="monitor-title">
  <header class="monitor-header">
    <div>
      <p class="eyebrow">MESURES PUBLIQUES LIMITÉES</p>
      <h2 id="monitor-title">Ressources publiées du nœud</h2>
    </div>
    <span class="monitor-state" data-monitor-state={initialState} role="status" aria-live="polite">{getMonitoringStateLabel(initialState)}</span>
  </header>

  <p class="monitor-note" data-monitor-note>Supervision temporairement indisponible. Aucune mesure n’a encore été reçue.</p>

  <dl class="monitor-meta">
    <div>
      <dt>Périmètre</dt>
      <dd>Nœud Proxmox</dd>
    </div>
    <div>
      <dt>Dernière collecte</dt>
      <dd><time data-monitor-time aria-live="off">Aucune mesure reçue</time></dd>
    </div>
  </dl>

  <dl class="monitor-metrics" aria-label="Métriques courantes du nœud Proxmox">
    {monitoringMetricNames.map(name => (
      <div class="monitor-metric">
        <dt>{name === 'cpu_percent' ? 'CPU' : name === 'memory_percent' ? 'Mémoire' : 'Stockage système (rootfs)'}</dt>
        <dd>
          <span data-monitor-value={name}>Indisponible</span>
          <meter
            data-monitor-meter={name}
            min="0"
            max="100"
            hidden
            aria-label={getMonitoringMetricLabel(name)}
          ></meter>
        </dd>
      </div>
    ))}
  </dl>

  <p class="monitor-footnote">Le fichier public ne contient que des pourcentages courants. Le stockage concerne uniquement le système de fichiers racine (rootfs), pas tous les disques. L’historique détaillé et Grafana restent sur le réseau privé.</p>
</section>

<script>
  import {
    formatMonitoringPercent,
    formatMonitoringTimestamp,
    getMonitoringFailureState,
    getMonitoringMetricLabel,
    getMonitoringState,
    getMonitoringStateLabel,
    MONITORING_MAX_AGE_MS,
    MONITORING_REFRESH_MS,
    monitoringMetricNames,
    validateMonitoringSnapshot,
  } from '../lib/homelab-monitoring';
  import type { MonitoringSnapshot, MonitoringState } from '../types/homelab-monitoring';

  const METRICS_ENDPOINT = '/data/homelab-metrics.json';

  function initializeMonitoring(): void {
    const root = document.querySelector<HTMLElement>('[data-monitor-panel]');
    if (!root || root.dataset.monitorInitialized === 'true') return;

    root.dataset.monitorInitialized = 'true';
    const stateElement = root.querySelector<HTMLElement>('[data-monitor-state]');
    const noteElement = root.querySelector<HTMLElement>('[data-monitor-note]');
    const timeElement = root.querySelector<HTMLTimeElement>('[data-monitor-time]');
    let lastSnapshot: MonitoringSnapshot | null = null;
    let refreshTimer: number | undefined;
    let staleTimer: number | undefined;
    let timeoutTimer: number | undefined;
    let activeRequest: AbortController | null = null;
    let isRefreshing = false;
    let disposed = false;

    const renderState = (state: MonitoringState) => {
      root.dataset.state = state;
      if (stateElement && stateElement.dataset.monitorState !== state) {
        stateElement.dataset.monitorState = state;
        stateElement.textContent = getMonitoringStateLabel(state);
      }
    };

    const renderSnapshot = (
      snapshot: MonitoringSnapshot | null,
      state: MonitoringState,
      showLastKnown = false,
    ) => {
      renderState(state);

      if (!snapshot) {
        if (timeElement) {
          timeElement.textContent = 'Aucune mesure reçue';
          timeElement.removeAttribute('datetime');
        }
        for (const name of monitoringMetricNames) {
          const valueElement = root.querySelector<HTMLElement>(`[data-monitor-value="${name}"]`);
          const meter = root.querySelector<HTMLMeterElement>(`[data-monitor-meter="${name}"]`);
          if (valueElement) valueElement.textContent = 'Indisponible';
          if (meter) meter.hidden = true;
        }
        return;
      }

      if (timeElement) {
        timeElement.dateTime = snapshot.collected_at;
        timeElement.textContent = formatMonitoringTimestamp(snapshot.collected_at);
      }

      for (const name of monitoringMetricNames) {
        const value = snapshot[name];
        const valueElement = root.querySelector<HTMLElement>(`[data-monitor-value="${name}"]`);
        const meter = root.querySelector<HTMLMeterElement>(`[data-monitor-meter="${name}"]`);
        if (valueElement) {
          const formatted = formatMonitoringPercent(value);
          valueElement.textContent = state === 'stale'
            ? `Mesure ancienne : ${formatted}`
            : showLastKnown
              ? `Dernière mesure reçue : ${formatted}`
              : formatted;
        }
        if (meter) {
          meter.hidden = state !== 'available' || showLastKnown;
          if (state === 'available' && !showLastKnown) {
            meter.value = value;
            meter.setAttribute('aria-label', `${getMonitoringMetricLabel(name)} — ${formatMonitoringPercent(value)}`);
          }
        }
      }
    };

    const clearStaleTimer = () => {
      if (staleTimer !== undefined) window.clearTimeout(staleTimer);
      staleTimer = undefined;
    };

    const scheduleStaleTransition = (snapshot: MonitoringSnapshot) => {
      clearStaleTimer();
      if (getMonitoringState(snapshot) !== 'available') return;

      const becomesStaleAt = Date.parse(snapshot.collected_at) + MONITORING_MAX_AGE_MS;
      staleTimer = window.setTimeout(() => {
        if (disposed || lastSnapshot !== snapshot) return;
        const state = getMonitoringState(snapshot);
        if (state === 'stale') {
          renderSnapshot(snapshot, state);
          if (noteElement) noteElement.textContent = 'Cette collecte date de 15 minutes ou plus. Les valeurs affichées ne sont pas actuelles.';
        } else if (state === 'available') {
          scheduleStaleTransition(snapshot);
        }
      }, Math.max(1, becomesStaleAt - Date.now()));
    };

    const reportRefreshFailure = (message: string) => {
      const state = getMonitoringFailureState(lastSnapshot);
      const canShowLastKnown = lastSnapshot !== null && state === 'unavailable';
      renderSnapshot(lastSnapshot, state, canShowLastKnown);

      if (!noteElement) return;
      if (message === 'future-timestamp') {
        noteElement.textContent = lastSnapshot
          ? 'La source a fourni un horodatage situé dans le futur. La dernière mesure connue est conservée et n’est pas présentée comme actuelle.'
          : 'Horodatage incohérent : la date de collecte est située dans le futur. Supervision temporairement indisponible.';
      } else if (!lastSnapshot) {
        noteElement.textContent = 'Supervision temporairement indisponible. Aucune mesure valide n’a pu être récupérée.';
      } else if (state === 'stale') {
        noteElement.textContent = 'La récupération est temporairement indisponible et la dernière collecte date de 15 minutes ou plus. Les valeurs affichées sont anciennes.';
      } else {
        noteElement.textContent = 'La récupération a échoué. La dernière mesure connue est indiquée avec son horodatage, mais ne doit pas être considérée comme l’état actuel.';
      }
    };

    const refresh = async () => {
      if (disposed || isRefreshing) return;
      isRefreshing = true;
      activeRequest = new AbortController();
      timeoutTimer = window.setTimeout(() => activeRequest?.abort(), 10_000);

      try {
        const response = await fetch(METRICS_ENDPOINT, {
          headers: { Accept: 'application/json' },
          cache: 'no-store',
          signal: activeRequest.signal,
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        const result = validateMonitoringSnapshot(await response.json());
        if (!result.ok) throw new Error(result.reason);

        const state = getMonitoringState(result.snapshot);
        if (state === 'unavailable') throw new Error('future-timestamp');

        lastSnapshot = result.snapshot;
        renderSnapshot(lastSnapshot, state);
        scheduleStaleTransition(lastSnapshot);
        if (noteElement) {
          noteElement.textContent = state === 'stale'
            ? 'La source est accessible, mais sa dernière collecte date de 15 minutes ou plus. Les valeurs ne sont pas actuelles.'
            : 'Mesures courantes reçues depuis le JSON public. Le widget ne vérifie pas la disponibilité des services.';
        }
      } catch (error) {
        if (disposed) return;
        const message = error instanceof Error && error.message === 'future-timestamp'
          ? 'future-timestamp'
          : 'request-failed';
        reportRefreshFailure(message);
      } finally {
        if (timeoutTimer !== undefined) window.clearTimeout(timeoutTimer);
        timeoutTimer = undefined;
        activeRequest = null;
        isRefreshing = false;
      }
    };

    const dispose = () => {
      if (disposed) return;
      disposed = true;
      if (refreshTimer !== undefined) window.clearInterval(refreshTimer);
      clearStaleTimer();
      if (timeoutTimer !== undefined) window.clearTimeout(timeoutTimer);
      activeRequest?.abort();
      delete root.dataset.monitorInitialized;
      window.removeEventListener('pagehide', dispose);
      document.removeEventListener('astro:before-swap', dispose);
    };

    window.addEventListener('pagehide', dispose, { once: true });
    document.addEventListener('astro:before-swap', dispose, { once: true });
    void refresh();
    refreshTimer = window.setInterval(() => void refresh(), MONITORING_REFRESH_MS);
  }

  initializeMonitoring();
  document.addEventListener('astro:page-load', initializeMonitoring);
  window.addEventListener('pageshow', initializeMonitoring);
</script>
